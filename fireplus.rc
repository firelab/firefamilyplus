            MENUITEM "&Daily Listing",              ID_WEATHER_SEASONREPORTS_DAILYLISTING
            MENUITEM "Percentile &Weather",         ID_RERAP
            MENUITEM "FlamMap Fire Risk Export",    ID_WEATHER_FLAMMAPEXPORTS
        END
        MENUITEM "&Winds",                      ID_WEATHER_WINDS
        POPUP "&Term"
        BEGIN
            MENUITEM "&General",                    ID_TERM_GENERAL
            MENUITEM "&Working Set",                ID_TERM_WORKINGSET
        END
        MENUITEM SEPARATOR
        POPUP "&View Observations"
        BEGIN
            MENUITEM "&Daily",                      ID_WEATHER_VIEWOBSERVATIONS_DAILY
            MENUITEM "&All",                        ID_WEATHER_VIEWOBSERVATIONS_ALL
        END
        MENUITEM SEPARATOR
        MENUITEM "&NFDRS Calculator",           ID_WEATHER_NFDRSCALCULATOR
        MENUITEM SEPARATOR
        MENUITEM "Custom Yearly &Initialization", ID_CUSTOMYEARLYINITS
    END
    POPUP "F&ires"
    BEGIN
        MENUITEM "&Associations",               ID_FIRES_ASSOCIATIONS
        MENUITEM SEPARATOR
        POPUP "&Summary"
        BEGIN
            MENUITEM "&General",                    ID_FIRES_FIREBUSINESS
            MENUITEM "&Working Set",                ID_FIRES_SUMMARY_WORKINGSET
        END
        MENUITEM "&Fire Analysis",              ID_FIRES_FIREANALYSIS
        MENUITEM SEPARATOR
        MENUITEM "Fire &Business Candidates",   ID_WEATHER_FIREBUSINESSCANDIDATES
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Graph Options",              ID_OPTIONS_DISPLAYOPTONS
        MENUITEM "&Report Options",             32892
        POPUP "GS&I Options"
        BEGIN
            MENUITEM "&Current SIG/Station",        ID_LFIOPTIONS_CURRENTSIG
            MENUITEM "&Defaults",                   ID_LFIOPTIONS_DEFAULTS
        END
        POPUP "&Statistical Cause Codes"
        BEGIN
            MENUITEM "&USFS Codes",                 ID_OPTIONS_CAUSECODES
            MENUITEM "&DOI Codes",                  ID_OPTIONS_CAUSECODES2
        END
