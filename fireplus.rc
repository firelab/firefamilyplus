        END
        MENUITEM SEPARATOR
        MENUITEM "&Compact",                    ID_DATA_COMPACT
    END
    POPUP "Weathe&r"
    BEGIN
        MENUITEM "&Climatology",                ID_CLIMATOLOGY
        MENUITEM "&Event Locator",              ID_WEATHER_EVENTLOCATOR
        MENUITEM "&Fire Danger Projections",    ID_WEATHER_FORECASTING
