        MENUITEM SEPARATOR
        MENUITEM "&Saved run maintenance...",   ID_BATCH_SAVEDRUNMAINTENANCE
        MENUITEM "&Enable Run Saving",          ID_BATCH_ENABLERUNSAVING, CHECKED
        MENUITEM SEPARATOR
        POPUP "&Batch/Run Options"
        BEGIN
            MENUITEM "&General Batch Options",      ID_OPTIONS_BATCH
            MENUITEM "&Autosave Options",           ID_OPTIONS_BATCH2
        END
    END
    POPUP "&Window"
    BEGIN
