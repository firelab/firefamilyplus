IDD_ABOUTBOX DIALOGEX 0, 0, 363, 297
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About FireFamily Plus"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    LTEXT           "FireFamily Plus ",IDC_STATIC,154,7,119,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2000-2022",IDC_STATIC,154,27,119,8
    DEFPUSHBUTTON   "OK",IDOK,320,7,32,14,WS_GROUP
    LTEXT           "Version 5",IDC_VERSION_STRING,154,17,136,8
    EDITTEXT        IDC_EDIT1,7,132,356,164,ES_MULTILINE | ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    CONTROL         IDB_BITMAP_FFP5,IDC_STATIC,"Static",SS_BITMAP,7,7,133,123
END

IDD_FIREPLUS_FORM DIALOGEX 0, 0, 435, 239
STYLE DS_SETFONT | WS_CHILD
EXSTYLE WS_EX_CLIENTEDGE
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    EDITTEXT        IDC_DESCRIPTION,66,24,361,12,ES_AUTOHSCROLL
    COMBOBOX        IDC_SIGSTATION,23,63,125,108,CBS_DROPDOWNLIST | CBS_SORT | CBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_SYEAR,24,90,40,14,ES_AUTOHSCROLL
    CONTROL         "Spin1",IDC_SPIN1,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,63,90,11,14
    EDITTEXT        IDC_EYEAR,97,90,40,15,ES_AUTOHSCROLL
    CONTROL         "Spin2",IDC_SPIN2,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,137,89,11,14
    COMBOBOX        IDC_SMONTH,168,70,72,56,CBS_DROPDOWNLIST | CBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_SDAY,257,70,31,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "Spin3",IDC_SPIN3,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,287,67,9,14
    COMBOBOX        IDC_EMONTH,168,94,72,57,CBS_DROPDOWNLIST | CBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_EDAY,257,93,31,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "Spin4",IDC_SPIN4,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,287,92,9,14
    COMBOBOX        IDC_COMBO1,27,130,59,51,CBS_DROPDOWNLIST | CBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Fire Associations",IDC_FIRESBUTTON,165,127,74,14
    PUSHBUTTON      "Overlay Years",IDC_OVERLAYYEARS,319,97,50,14,NOT WS_VISIBLE | NOT WS_TABSTOP
    EDITTEXT        IDC_DBNAME,67,7,361,12,ES_AUTOHSCROLL | ES_READONLY,0,HIDC_DBNAME
    LTEXT           "Database Name:",IDC_STATIC,7,7,54,8
    LTEXT           "Description:",IDC_STATIC,7,25,38,8
    GROUPBOX        "Active Working Set Definition",IDC_STATIC,7,43,421,108
    GROUPBOX        "Data Years",IDC_DATAYEARS,19,79,132,31
    LTEXT           "thru",IDC_STATIC,75,94,13,8
    GROUPBOX        "Annual Filter (Time of Year)",IDC_STATIC,163,51,143,60
    LTEXT           "Month",IDC_STATIC,199,59,21,8
    LTEXT           "Day",IDC_STATIC,268,59,14,8
    LTEXT           "thru",IDC_STATIC,241,83,13,8
    LTEXT           "SIG/Station Metadata:",IDC_STATIC,7,153,101,8
    GROUPBOX        "SIG/Station",IDC_STATIC,20,53,131,26
    GROUPBOX        "Analysis Period Length (Days)",IDC_STATIC,19,121,131,24
    LTEXT           "Grid",IDC_GRID,7,163,421,68,WS_BORDER
    CONTROL         "Force NFDRS2016 Recompute",IDC_CHECK_FORCE_RECOMPUTE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,284,121,115,10
