        BEGIN
            MENUITEM "&Set By Filter",              ID_SNOWFLAG_SETBYFILTER
            MENUITEM "Set &Hourly from Daily",      ID_SNOWFLAG_FILLHOURLYFROMDAILY
        END
        MENUITEM "Set &Daily Obs",              ID_UTILITIES_SETDAILYOBS
    END
    POPUP "&Batch"
    BEGIN
        MENUITEM "&Create new batch",           ID_BATCH_CREATENEWBATCH
        MENUITEM "&Manage batch list",          ID_BATCH_MANAGEBATCHLIST
        MENUITEM "&Interactive",                ID_BATCH_INTERACTIVE
